# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Base de datos (docker compose usa estos valores por defecto)
POSTGRES_DB=mdf360
POSTGRES_USER=mdf360
POSTGRES_PASSWORD=cambia-esto

# Django (en producción DJANGO_DEBUG debe ser false y la clave, larga y aleatoria)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=   # opcional: se suma al origen de FRONTEND_URL

# Acceso (M1-17)
FRONTEND_URL=http://localhost:5173
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
ACTIVATION_TOKEN_HOURS=72

# Correo para recuperar el acceso (en desarrollo se imprime en consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MDF360 <no-reply@mdf360.local>
