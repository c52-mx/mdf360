# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Base de datos (docker compose usa estos valores por defecto)
POSTGRES_DB=mdf360
POSTGRES_USER=mdf360
POSTGRES_PASSWORD=cambia-esto

# Django (en producción DJANGO_DEBUG debe ser false y la clave, larga y aleatoria)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
