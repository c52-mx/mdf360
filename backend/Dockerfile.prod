FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Usuario sin privilegios; /data guarda las fotos (volumen persistente)
RUN useradd --create-home --uid 1000 app && mkdir -p /data/media && chown -R app /app /data
USER app
ENV MEDIA_ROOT=/data/media

RUN DJANGO_DEBUG=true python manage.py collectstatic --noinput

EXPOSE 8000
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3 --timeout 60 --access-logfile -"]
